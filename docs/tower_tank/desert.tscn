[sub_resource type="Shader" id="Shader_ihals"]
code = "shader_type spatial; render_mode cull_disabled; uniform vec4 tint : source_color; uniform vec2 sway = vec2(0.0); uniform float pace = 0.0; void vertex() { float w = clamp((1.29 - VERTEX.y) / 1.11, 0.0, 1.0); VERTEX.xz += sway * w * w; VERTEX.x += sin(TIME * 8.0 + VERTEX.z * 4.0) * 0.025 * pace * w; VERTEX.z += cos(TIME * 7.0 + VERTEX.x * 5.0) * 0.035 * pace * w; } void fragment() { ALBEDO = tint.rgb; ROUGHNESS = 0.94; }"

