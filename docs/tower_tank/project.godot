; Standalone combat-feel sandbox. Open this file in Godot 4.7.
config_version=5

[application]
config/name="Epic Battle Mages — Iron Citadel"
config/version="0.11.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.055, 0.069, 0.078, 1)

[audio]
driver/enable_input=false

[physics]
common/physics_ticks_per_second=60
